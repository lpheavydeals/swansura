{% doc %}
  @prompt
    I have 4 collection and add shop now button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collections-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collections-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collections-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-collections-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collections-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-collections-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-collections-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collections-grid__item-{{ ai_gen_id }}:hover .ai-collections-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collections-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collections-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collections-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.content_bg_color }};
  }

  .ai-collections-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 12px;
    color: {{ block.settings.title_color }};
  }

  .ai-collections-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 16px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  .ai-collections-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-collections-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-collections-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-collections-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collections-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-collections-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-collections-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collections-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collections-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-collections-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        <div class="ai-collections-grid__item-{{ ai_gen_id }}">
          <div class="ai-collections-grid__image-wrapper-{{ ai_gen_id }}">
            {% if collection != blank and collection.image %}
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.image.alt | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | times: block.settings.image_ratio | divided_by: 100 }}"
                class="ai-collections-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collections-grid__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
                {% if collection == blank %}
                  <div class="ai-collections-grid__empty-state-{{ ai_gen_id }}">
                    Next, add a collection
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <div class="ai-collections-grid__content-{{ ai_gen_id }}">
            {% if collection != blank %}
              <h3 class="ai-collections-grid__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% if block.settings.show_description and collection.description != blank %}
                <div class="ai-collections-grid__description-{{ ai_gen_id }}">
                  {{ collection.description | strip_html | truncate: 100 }}
                </div>
              {% endif %}
              <a href="{{ collection.url }}" class="ai-collections-grid__button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            {% else %}
              <h3 class="ai-collections-grid__title-{{ ai_gen_id }}">Collection {{ i }}</h3>
              <div class="ai-collections-grid__description-{{ ai_gen_id }}">
                Add a collection to display here
              </div>
              <span class="ai-collections-grid__button-{{ ai_gen_id }}" style="opacity: 0.5; cursor: default;">
                {{ block.settings.button_text }}
              </span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

