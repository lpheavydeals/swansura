{%- comment -%}
  VD10 offer (user, 20 Nov 2026): code VD10 = 10% off every product in the vilvah and deyga collections
  (DiscountCodeNode/2443873976707). Compact one-row strip, offer only (user: no delivery / SAVE5 fine print,
  minimal height).
  mode 'pdp': under the price on Vilvah / Deyga product pages, with the price after the code.
  mode 'brand': top of the product list on /collections/vilvah and /collections/deyga.
  Code chip = copy; 'Apply' uses Shopify's /discount/<code> link (code carries to bag + checkout).
  Params: mode, price (pdp, cents), url (where to return after applying).
{%- endcomment -%}
{%- liquid
  assign code = 'VD10'
  assign back = url | default: request.path
-%}
<style>
.swp .vd10{display:flex;align-items:center;gap:10px;border-radius:10px;background:linear-gradient(120deg,#133A2F,#1B4D3E 70%,#24624F);color:#F4EEE4;box-shadow:inset 0 0 0 1px rgba(232,201,143,.5);padding:8px 8px 8px 10px}
.swp .vd10 .vd-pct{flex:none;padding:5px 8px;border-radius:6px;background:linear-gradient(135deg,#EACB8E,#C4924A);color:#0F2E25;font-weight:800;font-size:12px;line-height:1;letter-spacing:.06em;white-space:nowrap}
.swp .vd10 .vd-txt{flex:1;min-width:0;font-size:13.5px;line-height:1.3;color:#fff}
.swp .vd10 .vd-txt b{font-weight:700}
.swp .vd10 .vd-txt span{color:#E6D3A8;white-space:nowrap}
.swp .vd10 .vd-code{flex:none;font-weight:800;letter-spacing:.14em;font-size:12px;padding:6px 9px;border:1.5px dashed #E8C98F;border-radius:6px;color:#fff;background:rgba(255,255,255,.06);cursor:pointer;line-height:1}
.swp .vd10 .vd-go{flex:none;display:inline-flex;align-items:center;min-height:30px;padding:0 12px;border-radius:6px;background:linear-gradient(135deg,#EACB8E,#C4924A);color:#0F2E25;font-weight:700;font-size:12px;text-decoration:none;white-space:nowrap}
.swp .vd10.pdp{margin:12px 0 2px}
.swp .vd10.brand{margin:0 0 18px}
@media (max-width:600px){.swp .vd10{gap:8px}.swp .vd10 .vd-txt{font-size:12.5px}.swp .vd10 .vd-code{display:none}}
</style>
<div class="vd10 {{ mode }}" role="note">
  <span class="vd-pct">10% OFF</span>
  <div class="vd-txt">
    {%- if mode == 'pdp' -%}
      {%- assign after = price | times: 0.9 | round -%}
      <b>Code {{ code }}</b> <span>· <strong data-vd10-price>{{ after | money }}</strong> with code</span>
    {%- else -%}
      <b>All Vilvah &amp; Deyga</b> <span>· code {{ code }}</span>
    {%- endif -%}
  </div>
  <button type="button" class="vd-code" data-vd10-copy="{{ code }}" aria-label="Copy code {{ code }}">{{ code }}</button>
  <a class="vd-go" href="/discount/{{ code }}?redirect={{ back | url_encode }}">Apply</a>
</div>
<script>
(function(){
  document.querySelectorAll('[data-vd10-copy]').forEach(function(b){
    if(b.dataset.vdBound)return;b.dataset.vdBound=1;
    b.addEventListener('click',function(){
      var c=b.getAttribute('data-vd10-copy');
      var done=function(){var t=b.textContent;b.textContent='Copied';setTimeout(function(){b.textContent=t},1400)};
      if(navigator.clipboard){navigator.clipboard.writeText(c).then(done,done)}else{done()}
    });
  });
  if(!document.querySelector('[data-vd10-price]'))return;
  document.addEventListener('change',function(e){
    if(!e.target||e.target.name!=='variant')return;
    var out=document.querySelector('[data-vd10-price]'),j=document.getElementById('sw-variants');
    if(!out||!j)return;
    try{var vs=JSON.parse(j.textContent).variants,id=+e.target.value;
      vs.forEach(function(v){if(v.id===id){out.textContent='£'+(Math.round(v.price*0.9)/100).toFixed(2)}});
    }catch(_){}
  });
})();
</script>
