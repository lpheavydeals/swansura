{%- comment -%}
  Site-wide structured data (rendered in <head> by layout/theme.liquid), added after the SEO crawl of 27 Oct 2026:
  - home: Organization + WebSite with SearchAction
  - collections (incl. /collections/all): BreadcrumbList + CollectionPage with an ItemList of the first 24 products
  - /collections (Brands A–Z), pages, blogs: BreadcrumbList (+ CollectionPage / Blog)
  - articles: BreadcrumbList (BlogPosting + FAQPage come from sw-p-article)
  Products keep their own Product/ProductGroup + BreadcrumbList + FAQPage in sw-p-product.
{%- endcomment -%}
{%- liquid
  assign root = shop.url | append: '/'
  assign pt = request.page_type
  assign search_tpl = root | append: 'search?q={search_term_string}'
-%}
{%- if pt == 'index' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":{{ root | append: '#organization' | json }},"name":"Swansura – The Body Studio","url":{{ root | json }},"logo":{{ 'swansura-logo.webp' | file_url | prepend: 'https:' | json }},"email":"info@swansura.com","sameAs":["https://www.instagram.com/swansura_thebodystudio/"],"contactPoint":{"@type":"ContactPoint","contactType":"customer service","email":"info@swansura.com","areaServed":"GB","availableLanguage":"en-GB"}},{"@type":"WebSite","@id":{{ root | append: '#website' | json }},"name":"Swansura","url":{{ root | json }},"publisher":{"@id":{{ root | append: '#organization' | json }}},"inLanguage":"en-GB","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":{{ search_tpl | json }}},"query-input":"required name=search_term_string"}}]}</script>
{%- elsif pt == 'collection' -%}
  {%- liquid
    assign c_name = collection.metafields.custom.h1.value | default: collection.title
    assign c_label = collection.title
    if collection.handle == 'all'
      assign c_name = 'Fragrances UK, Skincare UK and Haircare UK'
      assign c_label = 'Shop all'
    endif
    assign c_url = shop.url | append: collection.url
  -%}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ root | json }}},{"@type":"ListItem","position":2,"name":{{ c_label | json }},"item":{{ c_url | json }}}]},{"@type":"CollectionPage","name":{{ c_name | json }},"url":{{ c_url | json }}{% if collection.description != blank %},"description":{{ collection.description | strip_html | strip_newlines | truncate: 300 | json }}{% endif %},"inLanguage":"en-GB","mainEntity":{"@type":"ItemList","numberOfItems":{{ collection.products_count }},"itemListElement":[{%- for p in collection.products limit: 24 -%}{"@type":"ListItem","position":{{ forloop.index }},"url":{{ shop.url | append: p.url | json }},"name":{{ p.title | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}}]}</script>
{%- elsif pt == 'list-collections' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ root | json }}},{"@type":"ListItem","position":2,"name":"Brands A–Z","item":{{ shop.url | append: routes.collections_url | json }}}]},{"@type":"CollectionPage","name":"Perfume & Skincare Brands A–Z","url":{{ shop.url | append: routes.collections_url | json }},"inLanguage":"en-GB"}]}</script>
{%- elsif pt == 'page' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ root | json }}},{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ shop.url | append: page.url | json }}}]}</script>
{%- elsif pt == 'blog' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ root | json }}},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}}]},{"@type":"Blog","name":{{ blog.title | json }},"url":{{ shop.url | append: blog.url | json }},"inLanguage":"en-GB","publisher":{"@type":"Organization","name":"Swansura – The Body Studio","url":{{ root | json }}}}]}</script>
{%- elsif pt == 'article' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ root | json }}},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}]}</script>
{%- endif -%}
