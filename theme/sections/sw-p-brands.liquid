{%- comment -%}
  Brands A–Z, prototype markup (brandsAZ()): page header with share, letter bar, brand links with product counts in
  letter groups. Brands = collections with the custom.brand metafield (tools/shopify/proto_brands.py), sorted by name.
{%- endcomment -%}
{%- paginate collections by 250 -%}
{%- liquid
  assign names = ''
  assign total = 0
  assign n = 0
  for c in collections
    assign b = c.metafields.custom.brand.value
    if b != blank
      assign key = b.name | downcase | replace: 'ē', 'e' | replace: 'è', 'e' | replace: 'é', 'e'
      assign names = names | append: key | append: '|' | append: c.handle | append: '~'
      assign total = total | plus: c.products_count
      assign n = n | plus: 1
    endif
  endfor
  assign rows = names | split: '~' | sort
  assign letters = ''
  for r in rows
    assign l = r | slice: 0 | upcase
    unless letters contains l
      assign letters = letters | append: l
    endunless
  endfor
  assign letters = letters | split: ''
-%}
{%- endpaginate -%}
<div class="swp app"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:var(--ink)">Brands A–Z</span></nav>
  <div class="pagehead"><div><div class="eyebrow">{{ section.settings.eyebrow | escape }}</div><h1 data-label="Brands A–Z" style="font-size:clamp(34px,4.4vw,60px);margin-top:10px">{{ section.settings.heading | escape }}</h1><div class="share dark ph"><button class="sharebtn" data-share="{{ request.path }}" data-share-title="Brands A–Z | Swansura" data-share-text="{{ n }} skincare and fragrance houses at Swansura, 100% authentic and shipped from the UK" aria-expanded="false" aria-haspopup="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg><span>Share</span></button></div></div><p class="lede">{{ n }} skincare and fragrance houses, {{ total }} products. Each brand has its own page, linked from the homepage, menus and every product.</p></div>
  <div class="subnav">{%- for l in letters -%}<a href="#L-{{ l }}" data-jump="L-{{ l }}">{{ l }}</a>{%- endfor -%}</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:32px;padding-block:24px 72px">
    {%- for l in letters -%}<div id="L-{{ l }}"><div style="font-family:var(--display);font-weight:800;font-size:40px;border-bottom:1px solid var(--line);margin-bottom:10px">{{ l }}</div>
      {%- for r in rows -%}{%- assign first = r | slice: 0 | upcase -%}{%- if first == l -%}{%- assign hd = r | split: '|' | last -%}{%- assign c = collections[hd] -%}{%- assign b = c.metafields.custom.brand.value -%}
        <a href="{{ c.url }}" style="display:flex;justify-content:space-between;gap:8px;padding:5px 0"><span>{{ b.name | escape }}{% if b.partner %} <small style="color:var(--emerald);letter-spacing:.1em;text-transform:uppercase;font-size:10px">Official partner</small>{% endif %}</span><small style="color:var(--ink-2)">{{ c.products_count }}</small></a>
      {%- endif -%}{%- endfor -%}</div>{%- endfor -%}
  </div></div></div>

{% schema %}
{
  "name": "Swansura brands A–Z",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Every house we carry" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Perfume & Skincare Brands A–Z" }
  ]
}
{% endschema %}
