{%- comment -%} Studio Letter sign-up band, prototype markup (section.news#newsletter); Shopify customer form (tag: newsletter). {%- endcomment -%}
<div class="swp app"><section class="news" id="newsletter" aria-label="Newsletter">
  <div class="wrap">
    <div class="eyebrow" style="color:#E6D3A8">{{ section.settings.eyebrow | escape }}</div>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.text | escape }}</p>
    {%- form 'customer', id: 'newsForm', class: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p id="newsMsg">Thank you for signing up.</p>
      {%- else -%}
        <label for="newsEmail-{{ section.id }}" class="sr-only">Email address</label><input id="newsEmail-{{ section.id }}" type="email" name="contact[email]" required placeholder="Your email address" autocomplete="email"><button type="submit">Sign up</button>
        {%- if form.errors -%}<p role="alert" style="flex-basis:100%;margin-top:8px">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section></div>
{% schema %}
{
  "name": "Swansura Studio Letter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Studio Letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals, new arrivals and fragrance notes" },
    { "type": "text", "id": "text", "label": "Text", "default": "Our letter lands once or twice a month. Unsubscribe any time." }
  ],
  "presets": [{ "name": "Swansura Studio Letter" }]
}
{% endschema %}
