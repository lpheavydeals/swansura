{%- comment -%} Collection chips with counts, prototype markup (div.chips > a.chip + small), e.g. 'Gifts by price'. {%- endcomment -%}
<div class="swp app"><div class="wrap"><section style="padding-top:0"><div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="chips">
  {%- for block in section.blocks -%}{%- assign c = collections[block.settings.collection] -%}{%- if c != blank -%}<a class="chip" href="{{ c.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: c.title | escape }}<small>{{ c.products_count }} {{ section.settings.unit | escape }}</small></a>{%- endif -%}{%- endfor -%}
</div></section></div></div>

{% schema %}
{
  "name": "Swansura collection chips",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts by price" },
    { "type": "text", "id": "unit", "label": "Count word", "default": "gifts" }
  ],
  "blocks": [ { "type": "chip", "name": "Chip", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "label", "label": "Label" } ] } ],
  "presets": [{ "name": "Swansura collection chips" }]
}
{% endschema %}
