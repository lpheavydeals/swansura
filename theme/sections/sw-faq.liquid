{%- comment -%} FAQ band (sits just above the footer) with FAQPage structured data. {%- endcomment -%}
<section class="sw-sec sw-faq">
  <div class="page-width sw-faq__in">
    <div>
      <div class="sw-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="sw-faq__note">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="sw-faq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.q }}</summary>
          <div class="rte">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Swansura FAQs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions about Swansura" },
    { "type": "richtext", "id": "text", "label": "Note" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Are your products authentic?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Yes. Every product is 100% authentic.</p>" }
    ] }
  ],
  "presets": [{ "name": "Swansura FAQs", "blocks": [{ "type": "faq" }] }]
}
{% endschema %}
