{%- comment -%} 'Behind the brand' story: two product images + copy. {%- endcomment -%}
<section class="sw-sec">
  <div class="page-width sw-story{% if section.settings.reverse %} sw-story--rev{% endif %}">
    <div class="sw-story__imgs">
      {%- for p in section.settings.products limit: 2 -%}
        <a href="{{ p.url }}">{{ p.featured_media | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 990px) 24vw, 45vw', loading: 'lazy', alt: p.featured_media.alt | default: p.title }}</a>
      {%- endfor -%}
    </div>
    <div class="sw-story__copy">
      {%- if section.settings.eyebrow != blank -%}<div class="sw-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="sw-lede">{{ section.settings.text }}</div>
      <div class="sw-story__ctas">
        {%- if section.settings.button1_label != blank -%}<a class="sw-btn sw-btn--solid" href="{{ section.settings.button1_link }}">{{ section.settings.button1_label }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="sw-btn" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swansura brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Behind the brand · Official UK partner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deyga: grown, made, and now shipped from the UK" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "product_list", "id": "products", "label": "Two product images", "limit": 2 },
    { "type": "text", "id": "button1_label", "label": "Button 1" },
    { "type": "url", "id": "button1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button2_label", "label": "Button 2" },
    { "type": "url", "id": "button2_link", "label": "Button 2 link" },
    { "type": "checkbox", "id": "reverse", "label": "Images on the right", "default": false }
  ],
  "presets": [{ "name": "Swansura brand story" }]
}
{% endschema %}
