{%- comment -%}
  Announcement bar, prototype markup (aside.announce): all messages side by side on wide screens; one at a time,
  changing every second, up to 1320px (rotation in sw-proto.js). Bold text shows in gold.
  Also loads the older Swansura design system (swansura.css / .js) for sections not yet on the prototype markup.
{%- endcomment -%}
{%- comment -%} Fonts come from layout/theme.liquid; swansura.css only styles below-the-fold blocks (FAQs), so it loads without blocking the first paint {%- endcomment -%}
<link rel="stylesheet" href="{{ 'swansura.css' | asset_url }}" media="print" onload="this.media='all'"><noscript>{{ 'swansura.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'swansura.js' | asset_url }}" defer="defer"></script>
<div class="swp"><aside class="announce" aria-label="Offers"><div class="wrap">
  {%- for block in section.blocks -%}
    {%- assign txt = block.settings.text | replace: '<strong>', '<b>' | replace: '</strong>', '</b>' -%}
    {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ txt }}</a>
    {%- else -%}<span {{ block.shopify_attributes }}>{{ txt }}</span>{%- endif -%}
  {%- endfor -%}
</div></aside></div>

{% schema %}
{
  "name": "Swansura announcement",
  "class": "sw-announce-section",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text (bold shows in gold)", "default": "Free UK delivery over <strong>£40</strong>" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Swansura announcement", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
