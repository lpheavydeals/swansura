{%- comment -%} Seasonal gifting banner (Christmas): emerald silk band, link pills, gold button, three gift cards. {%- endcomment -%}
<section class="sw-sec sw-xmas">
  <div class="page-width sw-xmas__in">
    <div class="sw-xmas__copy">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.links != blank -%}<div class="sw-xmas__links">{{ section.settings.links }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="sw-btn sw-btn--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
    <div class="sw-xmas__pics">
      {%- for p in section.settings.products limit: 3 -%}
        <a class="sw-xmas__p sw-xmas__p{{ forloop.index0 }}" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
          {{ p.featured_media | image_url: width: 500 | image_tag: widths: '250, 375, 500', sizes: '(min-width: 990px) 16vw, 30vw', loading: 'lazy', alt: '' }}
          <span>{{ p.vendor }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swansura gifting banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Christmas gifting, sorted" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "inline_richtext", "id": "links", "label": "Link pills (add each as a link)" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Christmas gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product_list", "id": "products", "label": "Three gift products", "limit": 3 }
  ],
  "presets": [{ "name": "Swansura gifting banner" }]
}
{% endschema %}
