{%- comment -%}
  Homepage hero. The keyword H1 is the small gold line; the large line is styled text.
  The arch (skincare) and floating card (fragrance) slide together through product pairs.
{%- endcomment -%}
{%- liquid
  assign skin = section.settings.skin_products
  assign scent = section.settings.scent_products
  assign pairs = skin.count
  if scent.count < pairs
    assign pairs = scent.count
  endif
-%}
<section class="sw-hero" aria-label="{{ section.settings.h1 | escape }}">
  <div class="sw-hero__in page-width">
    <div class="sw-hero__copy">
      <h1 class="sw-eyebrow sw-hero__h1">{{ section.settings.h1 }}</h1>
      <p class="sw-hero__title">{{ section.settings.title }}</p>
      {%- if section.settings.lede != blank -%}<p class="sw-hero__lede">{{ section.settings.lede }}</p>{%- endif -%}
      <div class="sw-hero__ctas">
        {%- if section.settings.button1_label != blank -%}
          <a class="sw-btn sw-btn--gold" href="{{ section.settings.button1_link }}">{{ section.settings.button1_label }} <svg width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4"/></svg></a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="sw-btn sw-btn--light" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="sw-hero__facts">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if pairs > 0 -%}
      <div class="sw-hero__stage" data-sw-hero data-interval="{{ section.settings.interval | times: 1000 }}">
        <span class="sw-hero__ring" aria-hidden="true"></span>
        <div class="sw-hero__arch" aria-roledescription="carousel" aria-label="Featured skincare">
          <div class="sw-hero__track">
            {%- for p in skin limit: pairs -%}
              {%- liquid
                assign load = 'lazy'
                if forloop.first
                  assign load = 'eager'
                endif
              -%}
              <a class="sw-hero__slide" href="{{ p.url }}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
                {{ p.featured_media | image_url: width: 900 | image_tag: widths: '450, 600, 900', sizes: '(min-width: 990px) 34vw, 70vw', loading: load, alt: p.featured_media.alt | default: p.title }}
                <span class="sw-hero__tag">{{ p.title | split: ' – ' | first | truncatewords: 5, '' }} <i>{{ p.price | money }}</i></span>
              </a>
            {%- endfor -%}
          </div>
        </div>
        <div class="sw-hero__float" aria-label="Featured fragrance">
          <div class="sw-hero__track">
            {%- for p in scent limit: pairs -%}
              <a class="sw-hero__slide" href="{{ p.url }}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
                {{ p.featured_media | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: p.featured_media.alt | default: p.title }}
                <small>{{ p.vendor }}</small>
                <span>{{ p.title | split: ' – ' | first | truncatewords: 4, '' }}</span>
                <b>{{ p.price | money }}</b>
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Swansura hero",
  "settings": [
    { "type": "text", "id": "h1", "label": "H1 (small gold line, carries the keyword)", "default": "Natural skincare UK · Niche perfume" },
    { "type": "inline_richtext", "id": "title", "label": "Large headline", "default": "Rituals for the <strong>skin</strong>, <em>signatures</em> for the <strong>senses</strong>." },
    { "type": "textarea", "id": "lede", "label": "Sub-headline", "default": "Best-loved natural skincare and niche and designer perfume, in one UK studio. Chosen with care, 100% authentic, delivered from the UK." },
    { "type": "text", "id": "button1_label", "label": "Gold button", "default": "Shop skincare" },
    { "type": "url", "id": "button1_link", "label": "Gold button link" },
    { "type": "text", "id": "button2_label", "label": "Outline button", "default": "Discover fragrance" },
    { "type": "url", "id": "button2_link", "label": "Outline button link" },
    { "type": "product_list", "id": "skin_products", "label": "Skincare slides (arch)", "limit": 8 },
    { "type": "product_list", "id": "scent_products", "label": "Fragrance slides (card)", "limit": 8 },
    { "type": "range", "id": "interval", "label": "Seconds per pair", "min": 1, "max": 8, "step": 1, "default": 1 }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "value", "label": "Number", "default": "100%" },
      { "type": "text", "id": "label", "label": "Label", "default": "Authentic" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Swansura hero" }]
}
{% endschema %}
