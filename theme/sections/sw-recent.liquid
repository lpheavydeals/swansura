{%- comment -%}
  Recently viewed: remembers product handles in this browser (localStorage) and shows the
  last few others as small cards (filled in by swansura.js from /products/<handle>.js).
  Hidden until there is something to show.
{%- endcomment -%}
<section class="sw-sec sw-recent" data-sw-recent data-current="{% if product %}{{ product.handle }}{% endif %}" data-limit="{{ section.settings.limit }}" hidden>
  <div class="page-width">
    <div class="sw-head"><h2>{{ section.settings.heading }}</h2></div>
    <ul class="sw-recent__list" role="list" data-sw-recent-list></ul>
  </div>
</section>
{%- comment -%} Reserve the row before paint when this browser has viewed other products (no layout shift). {%- endcomment -%}
<script>
  (function () {
    try {
      var s = document.currentScript.previousElementSibling, c = s.dataset.current;
      var l = JSON.parse(localStorage.getItem('sw-recent') || '[]').filter(function (h) { return h !== c; });
      if (l.length) { s.hidden = false; s.classList.add('is-pending'); }
    } catch (e) {}
  })();
</script>

{% schema %}
{
  "name": "Swansura recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Swansura recently viewed" }]
}
{% endschema %}
