{%- comment -%}
  FAQ band generated from catalogue data (no hand-written answers needed), with FAQPage JSON-LD.
  Collection pages: product count, brands, price range, authenticity, delivery, returns.
  Product pages: the prototype's questions rebuilt from custom.sw (smell / for whom, or what it is /
  ingredients / use / types), then authenticity, partner status (Deyga/Vilvah), delivery and returns.
  Collections and Journal articles with a custom.faq metafield (prototype FAQs) show those instead.
  Extra questions can be added as blocks; they show after the generated ones.
  Sits below the newsletter, directly above the footer (agreed page order).
{%- endcomment -%}
{%- liquid
  assign sep = '~~'
  assign qs = ''
  assign as = ''
  if shop.refund_policy != blank
    assign returns_a = 'Our <a href="' | append: shop.refund_policy.url | append: '">refund policy</a> explains how returns work, including what to do if an item arrives damaged.'
  else
    assign returns_a = 'Please <a href="/pages/contact">contact us</a> and we will help with your return.'
  endif
  assign delivery_a = 'Orders are dispatched from the UK within 1–2 working days. UK delivery is free on orders over £40, and orders over £70 get free delivery plus £5 off.'

  assign faq_mf = blank
  if template.name == 'collection'
    assign faq_mf = collection.metafields.custom.faq.value
  elsif template.name == 'article'
    assign faq_mf = article.metafields.custom.faq.value
  endif

  if faq_mf != blank
    comment
      Prototype FAQs uploaded per collection / Journal article: json [[question, answer], ...]
    endcomment
    for pair in faq_mf
      assign qs = qs | append: pair[0] | append: sep
      assign a = pair[1] | escape
      assign as = as | append: a | append: sep
    endfor
    if template.name == 'article'
      assign heading = article.title | split: ':' | first | append: ': questions'
    else
      assign heading = collection.title | append: ' questions'
    endif

  elsif template.name == 'collection'
    assign name = collection.title
    assign count = collection.products_count
    assign brands = ''
    assign partner = false
    for vd in collection.all_vendors
      assign vl = vd | downcase | strip
      if vl == 'generic' or vl contains 'swansura'
        continue
      endif
      assign shown = vd
      if vl contains 'vilvah'
        assign shown = 'Vilvah'
        assign partner = true
      elsif vl == 'deyga'
        assign partner = true
      endif
      unless brands contains shown
        assign brands = brands | append: shown | append: sep
      endunless
    endfor
    assign brand_list = brands | split: sep
    assign min = 0
    assign max = 0
    for p in collection.products limit: 50
      if min == 0 or p.price_min < min
        assign min = p.price_min
      endif
      if p.price_max > max
        assign max = p.price_max
      endif
    endfor

    if count > 0
      assign q = 'How many ' | append: name | append: ' products does Swansura stock?'
      assign a = 'We have ' | append: count | append: ' products in ' | append: name
      if brand_list.size > 1
        assign a = a | append: ' from ' | append: brand_list.size | append: ' brands, including ' | append: brand_list[0] | append: ', ' | append: brand_list[1]
        if brand_list.size > 2
          assign a = a | append: ' and ' | append: brand_list[2]
        endif
      elsif brand_list.size == 1
        assign a = a | append: ', all from ' | append: brand_list[0]
      endif
      assign a = a | append: '.'
      assign qs = qs | append: q | append: sep
      assign as = as | append: a | append: sep
    endif
    if count > 0 and count <= 50 and max > 0
      assign q = 'How much do ' | append: name | append: ' products cost?'
      assign min_m = min | money
      assign max_m = max | money
      if min == max
        assign a = 'Every product here costs ' | append: min_m | append: '.'
      else
        assign a = 'Prices run from ' | append: min_m | append: ' to ' | append: max_m | append: '. Use the price filter to narrow the list.'
      endif
      assign qs = qs | append: q | append: sep
      assign as = as | append: a | append: sep
    endif
    assign qs = qs | append: 'Are the products authentic?' | append: sep
    if partner
      assign as = as | append: 'Yes. Every product is 100% authentic, and Swansura is an official UK partner of Deyga and Vilvah.' | append: sep
    else
      assign as = as | append: 'Yes. Every product we sell is 100% authentic.' | append: sep
    endif
    assign qs = qs | append: 'How fast is UK delivery, and is it free?' | append: sep
    assign as = as | append: delivery_a | append: sep
    assign qs = qs | append: 'Can I return an item?' | append: sep
    assign as = as | append: returns_a | append: sep
    assign heading = name | append: ' questions'

  elsif template.name == 'product'
    assign short = product.title | split: ' – ' | first | split: ' | ' | first | truncatewords: 10, ''
    assign vl = product.vendor | downcase | strip
    assign brand_name = product.vendor
    if vl contains 'vilvah'
      assign brand_name = 'Vilvah'
    endif
    assign partner = false
    if vl == 'deyga' or vl contains 'vilvah'
      assign partner = true
    endif
    assign sw = product.metafields.custom.sw.value
    assign delivery_p = 'Orders are usually dispatched within 1–2 working days from the UK. Delivery is free over £40, and orders over £70 get free delivery plus £5 off. ' | append: returns_a

    if sw.f != blank
      comment
        Fragrance (custom.sw from the prototype): smell, who it is for, longevity, authenticity, delivery
      endcomment
      assign qs = qs | append: 'What does ' | append: short | append: ' smell like?' | append: sep
      assign a = sw.a[0] | escape
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'Is it for men or women?' | append: sep
      if sw.w == 'For him'
        assign as = as | append: 'It is presented as a men’s fragrance, but scent has no rules.' | append: sep
      elsif sw.w == 'For her'
        assign as = as | append: 'It is presented as a women’s fragrance, but scent has no rules.' | append: sep
      else
        assign as = as | append: 'It is a unisex fragrance, worn by everyone.' | append: sep
      endif
      assign qs = qs | append: 'How do I make it last longer?' | append: sep
      assign as = as | append: 'Apply to moisturised skin on pulse points (wrists, neck, behind the ears) and don’t rub. Layering over an unscented body butter helps it last.' | append: sep
      assign qs = qs | append: 'Is this the genuine ' | append: brand_name | append: ' fragrance?' | append: sep
      assign as = as | append: 'Yes. Every fragrance at Swansura is 100% authentic, sourced through authorised channels and shipped from the UK.' | append: sep
      assign qs = qs | append: 'How fast is delivery, and can I return it?' | append: sep
      assign as = as | append: delivery_p | append: sep

    elsif sw.a != blank
      comment
        Skincare / hair / body (custom.sw): what it is, key ingredients, how to use, types, authenticity, delivery
      endcomment
      assign qs = qs | append: 'What is ' | append: short | append: '?' | append: sep
      assign a = sw.a[0] | escape
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'What are the key ingredients?' | append: sep
      assign a = sw.a[1] | escape
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'How do I use it?' | append: sep
      assign a = sw.a[2] | escape
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'Which skin or hair types is it for?' | append: sep
      assign a = sw.a[3] | escape
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'Is this the genuine ' | append: brand_name | append: ' product?' | append: sep
      if partner
        assign as = as | append: 'Yes. Swansura is an official UK partner of ' | append: brand_name | append: ', and stock comes direct from the brand.' | append: sep
      else
        assign as = as | append: 'Yes. Every product at Swansura is 100% authentic and sourced through authorised channels.' | append: sep
      endif
      assign qs = qs | append: 'How fast is delivery, and can I return it?' | append: sep
      assign as = as | append: delivery_p | append: sep

    else
      assign qs = qs | append: 'Is ' | append: short | append: ' authentic?' | append: sep
      if partner
        assign a = 'Yes. Swansura is an official UK partner of ' | append: brand_name | append: ', and every product we sell is 100% authentic.'
      else
        assign a = 'Yes. Every product we sell is 100% authentic.'
      endif
      assign as = as | append: a | append: sep
      assign qs = qs | append: 'How quickly will my order arrive?' | append: sep
      assign as = as | append: 'We dispatch from the UK within 1–2 working days, so most UK orders arrive within a few days of ordering.' | append: sep
      assign qs = qs | append: 'Is UK delivery free?' | append: sep
      assign as = as | append: 'UK delivery is free on orders over £40, and orders over £70 get free delivery plus £5 off.' | append: sep
      assign qs = qs | append: 'Can I return it?' | append: sep
      assign as = as | append: returns_a | append: sep
    endif
    assign heading = short | append: ' questions'
  endif

  assign q_list = qs | split: sep
  assign a_list = as | split: sep
-%}
{%- if q_list.size > 0 or section.blocks.size > 0 -%}
<div class="swp"><section class="faqslot" id="faqslot" aria-label="Frequently asked questions"><div class="wrap"><div class="lfaq" data-faq style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:40px;padding-bottom:56px"><div><div class="eyebrow">{{ section.settings.eyebrow | escape }}</div><h2 style="margin-top:10px">{{ heading | default: section.settings.heading | escape }}</h2></div><div class="faq">
  {%- for q in q_list -%}<details><summary>{{ q | escape }}</summary><p>{{ a_list[forloop.index0] }}</p></details>{%- endfor -%}
  {%- for block in section.blocks -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary>{{ block.settings.a }}</details>{%- endfor -%}
</div><script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {%- for q in q_list -%}{"@type":"Question","name":{{ q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a_list[forloop.index0] | strip_html | json }}}}{% unless forloop.last and section.blocks.size == 0 %},{% endunless %}{%- endfor -%}
    {%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
  ]}
</script></div></div></section></div>
{%- endif -%}

{% schema %}
{
  "name": "Swansura FAQs (auto)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading (fallback)", "default": "Questions about Swansura" }
  ],
  "blocks": [
    { "type": "faq", "name": "Extra question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ],
  "enabled_on": { "templates": ["product", "collection", "article", "page", "list-collections", "blog"] },
  "presets": [{ "name": "Swansura FAQs (auto)" }]
}
{% endschema %}
