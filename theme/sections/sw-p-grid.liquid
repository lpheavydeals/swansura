{%- comment -%} Product grid band, prototype markup (section > .sec-head + .grid-p of cards): the first available products of a collection. {%- endcomment -%}
{%- assign c = collections[section.settings.collection] -%}
{%- if c != blank -%}
<div class="swp app"><div class="wrap"><section{% if section.settings.flush %} style="padding-top:0"{% endif %}><div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div>{%- if section.settings.link_label != blank -%}<a class="p-link" href="{{ section.settings.link_url | default: c.url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}</div><div class="grid-p">
  {%- assign k = 0 -%}{%- for p in c.products limit: 100 -%}{%- if p.available and k < section.settings.limit -%}{%- assign k = k | plus: 1 -%}{% render 'sw-p-card', product: p %}{%- endif -%}{%- endfor -%}
</div></section></div></div>
{%- endif -%}

{% schema %}
{
  "name": "Swansura product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready-made kits" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link (defaults to the collection)" },
    { "type": "checkbox", "id": "flush", "label": "No top padding", "default": false }
  ],
  "presets": [{ "name": "Swansura product grid" }]
}
{% endschema %}
