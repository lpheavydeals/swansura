{%- comment -%} The Journal teaser, prototype markup (div.journal.rail > a.post): image, tag eyebrow, title, summary. {%- endcomment -%}
{%- assign blog = blogs[section.settings.blog] -%}
<div class="swp app"><section><div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div><a class="p-link" href="{{ blog.url }}">{{ section.settings.link_label | escape }}</a></div>
    <div class="journal rail">{%- for a in blog.articles limit: section.settings.limit -%}<a class="post" href="{{ a.url }}">{%- if a.image -%}{{ a.image | image_url: width: 900 | image_tag: class: 'pic', widths: '400,600,900', sizes: '(min-width: 900px) 400px, 70vw', loading: 'lazy', alt: a.image.alt | default: a.title }}{%- else -%}<div class="pic"></div>{%- endif -%}<span class="eyebrow">{{ a.tags.first | escape }}</span><h3>{{ a.title | escape }}</h3><p style="color:var(--ink-2);font-size:15px">{{ a.excerpt_or_content | strip_html | truncate: 140 | escape }}</p></a>{%- endfor -%}</div>
  </div></section></div>
{% schema %}
{
  "name": "Swansura Journal teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Journal" },
    { "type": "text", "id": "link_label", "label": "Header link", "default": "All stories" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Stories", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Swansura Journal teaser" }]
}
{% endschema %}
