{%- comment -%}
  Bag page (/cart). The bag is rendered here in Liquid with the same markup sw-proto.js uses, so the items,
  subtotal and checkout show at once (user, 27 Oct 2026: the page used to be empty until every image had loaded,
  so only the footer showed). sw-proto.js then redraws it with the delivery bar, extras and live quantity buttons.
{%- endcomment -%}
<div class="swp app"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:var(--ink)">Bag</span></nav>
  <h1 class="visually-hidden">Your bag</h1>
  <div id="bagPage"><div class="bag" role="region" aria-label="Your bag">
    <div class="bag-head"><h3>Your bag</h3></div>
    <div class="bag-body"><div class="lines">
      {%- for l in cart.items -%}
        <div class="line">
          {%- if l.image -%}{{ l.image | image_url: width: 200 | image_tag: class: 'pic', alt: l.product.title, width: 200, height: 250 }}{%- else -%}<div class="pic"></div>{%- endif -%}
          <div><div style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--brass-ink)">{{ l.vendor | escape }}</div>
            <a href="{{ l.url }}">{{ l.product.title | escape }}{% unless l.product.has_only_default_variant %} · {{ l.variant.title | escape }}{% endunless %}</a>
            <div class="bq"><div class="qty sm"><button data-bq="{{ l.key }}|{{ l.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button><span>{{ l.quantity }}</span><button data-bq="{{ l.key }}|{{ l.quantity | plus: 1 }}" aria-label="Increase quantity">+</button></div><button class="rm" data-bq="{{ l.key }}|0">Remove</button></div></div>
          <div>{{ l.final_line_price | money }}</div>
        </div>
      {%- else -%}
        <div class="bag-empty"><p>Your bag is empty.</p><a class="btn solid" href="{{ routes.all_products_collection_url }}">Shop bestsellers</a><a class="p-link" href="/pages/rituals">Or start with a routine</a></div>
      {%- endfor -%}
    </div></div>
    <div class="foot">
      {%- if cart.total_discount > 0 -%}<div style="display:flex;justify-content:space-between;font-size:14px;color:var(--emerald)"><span>Savings</span><b>−{{ cart.total_discount | money }}</b></div>{%- endif -%}
      {%- if cart.item_count > 0 -%}<div class="bag-ship"><span>Standard delivery</span><b>{% if cart.total_price >= 4000 %}Free{% else %}£1.99{% endif %}</b></div>{%- endif -%}
      <div class="bag-sub"><span>Subtotal{% if cart.item_count > 0 %} ({{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}){% endif %}</span><b>{{ cart.total_price | money }}</b></div>
      <p class="bag-note">Taxes included. Delivery and discount codes are added at checkout.</p>
      <a class="btn solid" id="checkoutBtn" href="{{ routes.root_url }}checkout"{% if cart.item_count == 0 %} aria-disabled="true" style="pointer-events:none;opacity:.5"{% endif %}>Checkout securely</a>
    </div>
  </div></div>
</div></div>
<script>(function r(){ if (window.swOpenBag) window.swOpenBag(); else if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', r, { once: true }); else window.addEventListener('load', r, { once: true }); })();</script>

{% schema %}
{ "name": "Swansura bag page", "settings": [] }
{% endschema %}
