{%- comment -%}
  Advent calendar cards, prototype markup (div.advents > article.advent.skin|scent): eyebrow, name, text, price,
  buttons and a strip of six product photos. The price shows only when a calendar product is set (price from
  Shopify, 'worth' from the setting); until then it reads 'Coming soon' and the button is 'Notify me at launch'.
{%- endcomment -%}
<div class="swp app"><section><div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div>{%- if section.settings.link_label != blank -%}<a class="p-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}</div>
    <div class="advents" style="padding-top:0">
      {%- for block in section.blocks -%}{%- assign cal = block.settings.calendar -%}
        <article class="advent {{ block.settings.kind }}" {{ block.shopify_attributes }}><div class="advent-top"><div class="eyebrow">{{ block.settings.eyebrow | escape }}</div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p>
    {%- if cal != blank -%}
      <div class="advent-price"><span class="now">{{ cal.price | money_without_trailing_zeros }}</span>{%- if block.settings.worth > 0 -%}{%- assign worth_p = block.settings.worth | times: 100 -%}{%- assign pct = cal.price | times: 100 | divided_by: worth_p -%}<span class="worth">Worth £{{ block.settings.worth }}</span><span class="save">Save {{ 100 | minus: pct }}%</span>{%- endif -%}</div>
      <div class="advent-ctas"><a class="btn p-light" href="{{ block.settings.inside_url }}">See what's inside</a>{%- if cal.available -%}<button class="btn p-light" data-add="{{ cal.selected_or_first_available_variant.id }}">Add to bag</button>{%- else -%}<button class="btn p-light" data-notify="{{ block.settings.kind }}">Notify me at launch</button>{%- endif -%}</div>
    {%- else -%}
      <div class="advent-price"><span class="now">Coming soon</span></div>
      <div class="advent-ctas"><a class="btn p-light" href="{{ block.settings.inside_url }}">See what's inside</a><button class="btn p-light" data-notify="{{ block.settings.kind }}">Notify me at launch</button></div>
    {%- endif -%}</div>
    <div class="advent-strip">{%- for p in block.settings.strip limit: 6 -%}{{ p.featured_media.preview_image | image_url: width: 300 | image_tag: class: 'pic', widths: '150,300', sizes: '120px', loading: 'lazy', alt: p.featured_media.alt }}{%- endfor -%}</div></article>
      {%- endfor -%}
    </div>
  </div></section></div>
{% schema %}
{
  "name": "Swansura advent cards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Christmas 2026 · Advent calendars" },
    { "type": "text", "id": "link_label", "label": "Header link", "default": "Choose your advent" },
    { "type": "url", "id": "link_url", "label": "Header link URL" }
  ],
  "blocks": [
    { "type": "advent", "name": "Calendar", "settings": [
      { "type": "select", "id": "kind", "label": "Colour", "default": "skin", "options": [ { "value": "skin", "label": "Emerald (skin)" }, { "value": "scent", "label": "Oud (scent)" } ] },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Name" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "product", "id": "calendar", "label": "Calendar product (shows price + Add to bag)" },
      { "type": "number", "id": "worth", "label": "Worth (£)" },
      { "type": "url", "id": "inside_url", "label": "'See what's inside' link" },
      { "type": "product_list", "id": "strip", "label": "Strip photos", "limit": 6 }
    ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Swansura advent cards" }]
}
{% endschema %}
