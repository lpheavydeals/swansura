{%- comment -%}
  Advent calendar cards, prototype markup (div.advents > article.advent.skin|scent): eyebrow, name, text, price,
  buttons and a strip of six product photos. The price shows only when a calendar product is set (price from
  Shopify, 'worth' from the setting); until then it reads 'Coming soon' and the button is 'Notify me at launch'.
{%- endcomment -%}
{%- assign page_mode = false -%}{%- if section.settings.layout == 'page' -%}{%- assign page_mode = true -%}{%- endif -%}
<div class="swp app">{% if page_mode %}<div class="wrap">{% else %}<section><div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div>{%- if section.settings.link_label != blank -%}<a class="p-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}</div>{% endif %}
    <div class="advents"{% unless page_mode %} style="padding-top:0"{% endunless %}>
      {%- for block in section.blocks -%}{%- assign cal = block.settings.calendar -%}
        <article class="advent {{ block.settings.kind }}" {{ block.shopify_attributes }}><div class="advent-top"><div class="eyebrow">{{ block.settings.eyebrow | escape }}</div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p>
    {%- if cal != blank -%}
      <div class="advent-price"><span class="now">{{ cal.price | money_without_trailing_zeros }}</span>{%- if block.settings.worth > 0 -%}{%- assign worth_p = block.settings.worth | times: 100 -%}{%- assign pct = cal.price | times: 100 | divided_by: worth_p -%}<span class="worth">Worth £{{ block.settings.worth }}</span><span class="save">Save {{ 100 | minus: pct }}%</span>{%- endif -%}</div>
      <div class="advent-ctas"><a class="btn p-light" href="{{ block.settings.inside_url }}">See what's inside</a>{%- if cal.available -%}<button class="btn p-light" data-add="{{ cal.selected_or_first_available_variant.id }}">Add to bag</button>{%- else -%}<button class="btn p-light" data-notify="{{ block.settings.kind }}">Notify me at launch</button>{%- endif -%}</div>
    {%- else -%}
      <div class="advent-price"><span class="now">Coming soon</span></div>
      <div class="advent-ctas"><a class="btn p-light" href="{{ block.settings.inside_url }}">See what's inside</a><button class="btn p-light" data-notify="{{ block.settings.kind }}">Notify me at launch</button></div>
    {%- endif -%}</div>
    <div class="advent-strip">{%- for p in block.settings.strip limit: 6 -%}{{ p.featured_media.preview_image | image_url: width: 300 | image_tag: class: 'pic', widths: '150,300', sizes: '120px', loading: 'lazy', alt: p.featured_media.alt }}{%- endfor -%}</div></article>
      {%- endfor -%}
    </div>
  {%- if page_mode -%}
    {%- comment -%} Perks, then 12 doors per calendar (adventPage()): opened doors are remembered in this browser {%- endcomment -%}
    <div class="advent-perks">
      <div><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg></span><b>Free UK delivery</b><small>on every advent calendar</small></div>
      <div><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19c0-8 6-13 14-14-1 8-6 14-14 14Z"/><path d="M5 19 13 11"/></svg></span><b>Real products</b><small>from brands we stock</small></div>
      <div><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><b>100% authentic</b><small>official UK partner of Deyga &amp; Vilvah</small></div>
      <div><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 10h11a5 5 0 0 1 0 10H8"/><path d="m8 6-4 4 4 4"/></svg></span><b>Gift-ready</b><small>wrapped and ready to give</small></div>
    </div>
    {%- for block in section.blocks -%}{%- if block.settings.contents.size > 0 -%}
      <section id="{{ block.settings.kind }}" style="padding-block:56px 8px"><div class="sec-head"><div><div class="eyebrow">Peek inside · {{ block.settings.contents.size }} doors</div><h2>{{ block.settings.heading | escape }}</h2></div><button class="p-link" data-revealall="{{ block.settings.kind }}">Reveal all {{ block.settings.contents.size }}</button></div>
        <div class="doors" data-doors="{{ block.settings.kind }}">
          {%- for p in block.settings.contents -%}{%- capture pn -%}{% render 'sw-p-name', product: p %}{%- endcapture -%}
            <button class="door" data-door="{{ block.settings.kind }}-{{ forloop.index }}" data-label="Day {{ forloop.index }}: {{ pn | escape }}" aria-label="Day {{ forloop.index }}"><span class="num">{{ forloop.index }}</span><span class="hint">Open</span><template>{{ p.featured_media.preview_image | image_url: width: 300 | image_tag: class: 'pic', loading: 'lazy', alt: '' }}<span class="dn">Day {{ forloop.index }}</span><span class="dt">{{ p.vendor | escape }} · {{ pn | escape }}</span><span class="dp">{{ p.selected_or_first_available_variant.price | money }}</span></template></button>
          {%- endfor -%}
        </div></section>
    {%- endif -%}{%- endfor -%}
    {%- assign more = collections[section.settings.more_collection] -%}
    {%- if more != blank -%}<section style="padding-top:0"><div class="sec-head"><div><h2>You might also like</h2></div><a class="p-link" href="{{ more.url }}">All {{ more.title | downcase | escape }}</a></div><div class="grid-p">{%- assign k = 0 -%}{%- for p in more.products limit: 40 -%}{%- if p.available and k < 4 -%}{%- assign k = k | plus: 1 -%}{% render 'sw-p-card', product: p %}{%- endif -%}{%- endfor -%}</div></section>{%- endif -%}
  </div></div>
  {%- else -%}
  </div></section></div>
  {%- endif -%}
{% schema %}
{
  "name": "Swansura advent cards",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "home", "label": "Homepage cards" }, { "value": "page", "label": "Advent page (cards, perks, doors)" }], "default": "home" },
    { "type": "collection", "id": "more_collection", "label": "Advent page: 'You might also like' from" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Christmas 2026 · Advent calendars" },
    { "type": "text", "id": "link_label", "label": "Header link", "default": "Choose your advent" },
    { "type": "url", "id": "link_url", "label": "Header link URL" }
  ],
  "blocks": [
    { "type": "advent", "name": "Calendar", "settings": [
      { "type": "select", "id": "kind", "label": "Colour", "default": "skin", "options": [ { "value": "skin", "label": "Emerald (skin)" }, { "value": "scent", "label": "Oud (scent)" } ] },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Name" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "product", "id": "calendar", "label": "Calendar product (shows price + Add to bag)" },
      { "type": "number", "id": "worth", "label": "Worth (£)" },
      { "type": "url", "id": "inside_url", "label": "'See what's inside' link" },
      { "type": "product_list", "id": "strip", "label": "Strip photos", "limit": 6 },
      { "type": "product_list", "id": "contents", "label": "Advent page: what's behind the doors", "limit": 24 }
    ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Swansura advent cards" }]
}
{% endschema %}
