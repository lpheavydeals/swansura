{%- comment -%} Keyword link pills ('Most searched', 'Popular searches'). On phones more than 4 pills scroll sideways in two rows. {%- endcomment -%}
<section class="sw-sec sw-chips-sec{% if section.settings.band %} sw-band{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="sw-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="sw-chips">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swansura link pills",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular searches" },
    { "type": "checkbox", "id": "band", "label": "Tinted background band", "default": false }
  ],
  "blocks": [
    { "type": "chip", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Natural skincare" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Swansura link pills", "blocks": [{ "type": "chip" }] }]
}
{% endschema %}
