{%- comment -%} The Studio Letter: plain newsletter sign-up on an emerald band (no offer until the client confirms one). {%- endcomment -%}
<section class="sw-sec sw-news" id="newsletter">
  <div class="page-width sw-news__in">
    <div class="sw-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- form 'customer', id: 'SwNewsletter', class: 'sw-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="SwNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
      <input id="SwNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address">
      <button type="submit">{{ section.settings.button }}</button>
      {%- if form.posted_successfully? -%}<p class="sw-news__ok" role="status">{{ section.settings.success }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="sw-news__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Swansura newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Studio Letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals, new arrivals and fragrance notes" },
    { "type": "text", "id": "text", "label": "Text", "default": "Our letter lands once or twice a month. Unsubscribe any time." },
    { "type": "text", "id": "button", "label": "Button", "default": "Sign up" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you for signing up." }
  ],
  "presets": [{ "name": "Swansura newsletter" }]
}
{% endschema %}
