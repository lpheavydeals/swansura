{%- comment -%}
  Most loved routines, prototype markup (div.rituals.home4 > article.ritual): three product photos, group,
  name, intro, numbered steps, total and 'Add routine' (adds all three to the bag).
  The prototype shows a 5% routine saving; it only shows here when 'Routine discount is live' is on, because
  the saving must exist at checkout first (Shopify bundle / automatic discount).
{%- endcomment -%}
{%- if section.settings.layout == 'page' -%}
<div class="swp app"><section style="padding-block:48px 8px"><div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">{{ section.blocks.size }} routines</div><h2>{{ section.settings.heading | escape }}</h2></div></div>
    <div class="rituals">
{%- else -%}
<div class="swp app"><section style="background:var(--card);border-block:1px solid var(--line)"><div class="wrap">
    <div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div></div>
    <div class="rituals home4 rail">
{%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign total = 0 -%}{%- assign ids = '' -%}{%- assign np = 0 -%}
        {%- if block.settings.p1 != blank -%}{%- assign np = np | plus: 1 -%}{%- endif -%}{%- if block.settings.p2 != blank -%}{%- assign np = np | plus: 1 -%}{%- endif -%}{%- if block.settings.p3 != blank -%}{%- assign np = np | plus: 1 -%}{%- endif -%}
        <article class="ritual" {{ block.shopify_attributes }}><div class="imgs" style="grid-template-columns:repeat({{ np }},1fr)">
          {%- for i in (1..3) -%}{%- assign key = 'p' | append: i -%}{%- assign p = block.settings[key] -%}{%- if p != blank -%}<a href="{{ p.url }}">{{ p.featured_media.preview_image | image_url: width: 400 | image_tag: class: 'pic', widths: '200,300,400', sizes: '(min-width: 1100px) 100px, 30vw', loading: 'lazy', alt: p.featured_media.alt }}</a>{%- endif -%}{%- endfor -%}
        </div><div class="body"><div class="eyebrow">{{ block.settings.group | escape }}</div><h3>{{ block.settings.name | escape }}</h3><p style="color:var(--ink-2);font-size:15px">{{ block.settings.intro | escape }}</p><ol>
          {%- for i in (1..3) -%}{%- assign key = 'p' | append: i -%}{%- assign sk = 's' | append: i -%}{%- assign p = block.settings[key] -%}{%- if p != blank -%}
            {%- assign total = total | plus: p.selected_or_first_available_variant.price -%}{%- capture vid -%}{% render 'sw-p-variant', product: p %}{%- endcapture -%}{%- assign ids = ids | append: vid | append: ',' -%}
            {%- capture pn -%}{% render 'sw-p-name', product: p %}{%- endcapture -%}
            <li><b style="font-weight:600">{{ block.settings[sk] | escape }}</b> · <a href="{{ p.url }}">{{ pn | escape }}</a></li>
          {%- endif -%}{%- endfor -%}
        </ol><div class="foot">
          {%- if section.settings.discount_live -%}{%- assign save = total | times: section.settings.save_pct | divided_by: 100 -%}<div class="p-price">{{ total | minus: save | money }} <s>{{ total | money }}</s> <span class="off">SAVE {{ section.settings.save_pct }}%</span></div>
          {%- else -%}<div class="p-price">{{ total | money }}</div>{%- endif -%}
          <button class="btn solid rbtn" data-addall="{{ ids | remove_last: ',' }}">Add routine</button></div></div></article>
      {%- endfor -%}
    </div>
    {%- if section.settings.all_label != blank -%}<div class="viewall"><a class="btn" href="{{ section.settings.all_url }}">{{ section.settings.all_label | escape }}</a></div>{%- endif -%}
  </div></section></div>
{% schema %}
{
  "name": "Swansura routines",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "home", "label": "Homepage band" }, { "value": "page", "label": "Routines page group" }], "default": "home" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most loved routines" },
    { "type": "text", "id": "all_label", "label": "Button below", "default": "View all 16 routines" },
    { "type": "url", "id": "all_url", "label": "Button link" },
    { "type": "checkbox", "id": "discount_live", "label": "Routine discount is live at checkout", "default": false },
    { "type": "number", "id": "save_pct", "label": "Routine saving (%)", "default": 5 }
  ],
  "blocks": [
    { "type": "ritual", "name": "Routine", "settings": [
      { "type": "text", "id": "group", "label": "Group", "default": "Skincare routines" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "intro", "label": "Intro" },
      { "type": "text", "id": "s1", "label": "Step 1" }, { "type": "product", "id": "p1", "label": "Step 1 product" },
      { "type": "text", "id": "s2", "label": "Step 2" }, { "type": "product", "id": "p2", "label": "Step 2 product" },
      { "type": "text", "id": "s3", "label": "Step 3" }, { "type": "product", "id": "p3", "label": "Step 3 product" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Swansura routines" }]
}
{% endschema %}
