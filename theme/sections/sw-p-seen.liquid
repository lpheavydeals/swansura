{%- comment -%} 'Picking up where you left off' (homepage, after the brand stories): up to 4 recently viewed products, filled in by sw-proto.js; hidden until there is history. {%- endcomment -%}
<div class="swp app"><section style="padding-top:0" id="seenSec" hidden><div class="wrap"><div class="sec-head"><div><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="grid-p" id="seenGrid"></div></div></section></div>

{% schema %}
{ "name": "Swansura recently viewed", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Picking up where you left off" } ], "presets": [{ "name": "Swansura recently viewed" }] }
{% endschema %}
