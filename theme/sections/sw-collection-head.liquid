{%- comment -%}
  Collection / brand page header: silk band with breadcrumbs, eyebrow, H1, intro and product count.
  - H1 = collection.metafields.custom.h1 when set (keyword H1), else the collection title (no "Collection:" prefix).
  - Brand mode when every real vendor in the collection is one brand and the title names it
    (e.g. Tiziana Terenzi, Vilvah Store, Deyga Organics); Deyga and Vilvah get the partner eyebrow.
  - Colour: oud silk for fragrance (the Fragrance collection, or most of the first 8 products are in it),
    emerald silk otherwise, unless the section setting forces one.
{%- endcomment -%}
{%- liquid
  assign title_l = collection.title | downcase
  assign real = 0
  assign brand = ''
  assign skin = false
  assign partner = false
  for vd in collection.all_vendors
    assign vl = vd | downcase | strip
    if vl == 'generic' or vl contains 'swansura'
      continue
    endif
    assign real = real | plus: 1
    assign brand = vd
    if vl == 'deyga' or vl contains 'vilvah' or vl contains 'highborn'
      assign skin = true
    endif
    if vl == 'deyga' or vl contains 'vilvah'
      assign partner = true
    endif
  endfor
  if title_l contains 'deyga' or title_l contains 'vilvah'
    assign partner = true
    assign skin = true
  endif
  assign brand_l = brand | downcase | split: ' ' | first
  assign is_brand = false
  if section.settings.mode == 'brand'
    assign is_brand = true
  elsif section.settings.mode == 'auto'
    if real == 1 and title_l contains brand_l
      assign is_brand = true
    elsif partner and title_l contains 'deyga' or partner and title_l contains 'vilvah'
      assign is_brand = true
    endif
  endif
  assign tone = section.settings.tone
  if tone == 'auto'
    assign tone = 'skin'
    if collection.handle == 'fragrance'
      assign tone = 'scent'
    elsif skin == false
      assign frag = 0
      assign seen = 0
      for p in collection.products limit: 8
        assign seen = seen | plus: 1
        assign ph = p.collections | map: 'handle'
        if ph contains 'fragrance'
          assign frag = frag | plus: 1
        endif
      endfor
      assign half = seen | divided_by: 2.0
      if seen > 0 and frag > half
        assign tone = 'scent'
      endif
    endif
  endif
  assign h1 = collection.metafields.custom.h1.value | default: collection.title
  if is_brand
    if partner
      assign eyebrow = 'Official UK partner'
    else
      assign eyebrow = 'The brand'
    endif
  elsif tone == 'scent'
    assign eyebrow = 'Fragrance'
  else
    assign eyebrow = 'Shop'
  endif
-%}
<section class="sw-chead sw-chead--{{ tone }}{% if is_brand %} sw-chead--brand{% endif %}">
  <div class="page-width sw-chead__in">
    <nav class="sw-crumbs sw-crumbs--dark" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span>
      {%- if is_brand -%}<a href="{{ routes.collections_url }}">Brands</a><span aria-hidden="true">›</span>{%- endif -%}
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>
    <div class="sw-eyebrow sw-chead__eyebrow">{{ eyebrow }}</div>
    <h1 class="sw-chead__h1">{{ h1 | escape }}</h1>
    {%- if collection.description != blank and section.settings.show_intro -%}
      <div class="sw-chead__intro rte">{{ collection.description }}</div>
    {%- endif -%}
    <p class="sw-chead__count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
  </div>
</section>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }}},
          {"@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }}}
        ]
      },
      {
        "@type": "CollectionPage",
        "name": {{ h1 | json }},
        "url": {{ shop.url | append: collection.url | json }},
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ collection.products_count }},
          "itemListElement": [
            {%- for p in collection.products limit: 12 -%}
              {"@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: p.url | json }}, "name": {{ p.title | json }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      }
    ]
  }
</script>

{% schema %}
{
  "name": "Swansura collection head",
  "settings": [
    { "type": "select", "id": "mode", "label": "Page type", "default": "auto", "options": [
      { "value": "auto", "label": "Detect (brand or category)" },
      { "value": "brand", "label": "Brand page" },
      { "value": "category", "label": "Category page" }
    ] },
    { "type": "select", "id": "tone", "label": "Colour", "default": "auto", "options": [
      { "value": "auto", "label": "Detect (skincare emerald, fragrance oud)" },
      { "value": "skin", "label": "Emerald" },
      { "value": "scent", "label": "Oud" }
    ] },
    { "type": "checkbox", "id": "show_intro", "label": "Show collection description as intro", "default": true }
  ],
  "enabled_on": { "templates": ["collection"] },
  "presets": [{ "name": "Swansura collection head" }]
}
{% endschema %}
