{%- comment -%} Journal listing: silk header (H1 = blog title) and article cards (image, date, excerpt), 12 per page. {%- endcomment -%}
<section class="sw-chead sw-chead--skin">
  <div class="page-width sw-chead__in">
    <nav class="sw-crumbs sw-crumbs--dark" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">{{ blog.title | escape }}</span>
    </nav>
    <div class="sw-eyebrow sw-chead__eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="sw-chead__h1">{{ section.settings.heading | default: blog.title | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="sw-chead__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
  </div>
</section>
<section class="sw-sec">
  <div class="page-width">
    {%- paginate blog.articles by 12 -%}
      <ul class="sw-posts" role="list">
        {%- for a in blog.articles -%}
          <li class="sw-post">
            <a href="{{ a.url }}">
              <span class="sw-post__img">
                {%- if a.image -%}{{ a.image | image_url: width: 900 | image_tag: widths: '450, 600, 900', sizes: '(min-width: 990px) 33vw, 90vw', loading: 'lazy', alt: a.image.alt | default: a.title }}{%- endif -%}
              </span>
              <time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: '%-d %B %Y' }}</time>
              <h2>{{ a.title | escape }}</h2>
              <p>{{ a.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
              <span class="sw-link">Read the story</span>
            </a>
          </li>
        {%- else -%}
          <li><p>New stories are on the way.</p></li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Swansura journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to the blog title)" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "enabled_on": { "templates": ["blog"] },
  "presets": [{ "name": "Swansura journal" }]
}
{% endschema %}
