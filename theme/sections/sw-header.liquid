{%- comment -%}
  Site header, prototype markup (header.site): search left, logo centre, Brands A–Z / account / wishlist / bag right,
  main menu with mega panels from the 'menu' setting (3 levels: item → column heading → links).
  Also renders, once per page: the mobile drawer (template, from 'drawer_menu'), the bag/search config for
  sw-proto.js, the overlay layer and the help button + panel.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign drawer = linklists[section.settings.drawer_menu]
  assign skin_title = section.settings.feat_skin_item | downcase
  assign scent_title = section.settings.feat_scent_item | downcase
-%}
<div class="swp"><header class="site">
  <div class="wrap">
    <div class="hrow">
      <div class="hleft">
        <button class="burger" id="burger" aria-label="Open menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"></path></svg></button>
        <a href="{{ routes.search_url }}" id="openSearch" aria-label="Search" style="display:flex;gap:8px;align-items:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span class="txt">Search</span></a>
      </div>
      <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name | escape }}, home"><img src="{{ 'swansura-logo-brown.svg' | asset_url }}" alt="Swansura – The Body Studio" class="logo-img" width="115" height="70"></a>
      <div class="hright">
        <a href="{{ section.settings.brands_url | default: '/collections' }}" class="txt">Brands A–Z</a>
        {%- if shop.customer_accounts_enabled -%}<a class="hicon" id="openAccount" href="{{ routes.account_url }}" aria-label="Account"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></a>{%- endif -%}
        <a class="hicon" href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" aria-label="Wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"></path></svg><span class="bagcount wcount" id="wishCount" hidden>0</span></a>
        <a href="{{ routes.cart_url }}" id="openBag" aria-label="Open bag" style="display:flex;align-items:center"><span class="txt">Bag</span><span class="bagic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg><span class="bagcount" id="bagCount"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></span></a>
      </div>
    </div>
    <nav class="main" id="mainNav" aria-label="Main">
      {%- for link in menu.links -%}
        {%- liquid
          assign lt = link.title | downcase
          assign feat = blank
          if lt == skin_title
            assign feat = section.settings.feat_skin
          elsif lt == scent_title
            assign feat = section.settings.feat_scent
          endif
          assign ncols = link.links.size
          if feat != blank
            assign ncols = ncols | plus: 1
          endif
          assign mstyle = ''
          if ncols >= 5
            assign mstyle = 'grid-template-columns:repeat(5,1fr);width:min(1120px,94vw)'
          elsif ncols == 4 and feat == blank
            assign mstyle = 'grid-template-columns:repeat(4,1fr);width:min(860px,92vw)'
          elsif ncols <= 3
            assign mstyle = 'grid-template-columns:repeat(3,1fr);width:min(720px,92vw)'
          endif
          comment
            underline like the prototype: the exact page, Fragrance on scent families, Skincare on concerns
          endcomment
          assign on = false
          if link.url == request.path
            assign on = true
          elsif collection.handle contains 'scent-' and link.url == '/collections/fragrance'
            assign on = true
          elsif collection.handle contains 'concern-' and link.url == '/collections/skincare'
            assign on = true
          endif
          assign astyle = ''
          if lt contains 'advent'
            assign astyle = ' style="color:var(--brass-ink);font-weight:600"'
          endif
        -%}
        <div class="item"><a href="{{ link.url }}"{% if on %} class="on"{% endif %}{{ astyle }}>{{ link.title | escape }}</a>
          {%- if link.links.size > 0 -%}<div class="mega"{% if mstyle != '' %} style="{{ mstyle }}"{% endif %}>
            {%- for col in link.links -%}<div><h4>{{ col.title | escape }}</h4>{%- for l in col.links -%}<a href="{{ l.url }}">{{ l.title | escape }}{% if l.title contains 'A–Z' %} →{% endif %}</a>{%- endfor -%}</div>{%- endfor -%}
            {%- if feat != blank -%}{%- capture fname -%}{% render 'sw-p-name', product: feat %}{%- endcapture -%}<a class="feat" href="{{ feat.url }}">{{ feat.featured_media.preview_image | image_url: width: 400 | image_tag: class: 'pic', loading: 'lazy', alt: feat.featured_media.alt | default: feat.title }}<b style="font-weight:600">{{ fname | escape }}</b></a>{%- endif -%}
          </div>{%- endif -%}</div>
      {%- endfor -%}
    </nav>
  </div>
</header></div>

{%- comment -%} Mobile drawer (opened by the burger) {%- endcomment -%}
<template id="sw-drawer-tpl"><nav class="drawer-nav" aria-label="Menu">
    <div class="dn-top"><a href="{{ routes.root_url }}" class="logo"><img src="{{ 'swansura-logo-brown.svg' | asset_url }}" alt="Swansura – The Body Studio" class="logo-img dn" width="89" height="54"></a><button data-close aria-label="Close menu">Close</button></div>
    <button class="dn-search" id="drawerSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><span>Search products, brands, concerns</span></button>
    <div class="dn-feat"><a href="{{ section.settings.skin_url | default: '/collections/skincare' }}" class="sk"><span class="eyebrow">The Skin Studio</span><b>Natural skincare</b></a><a href="{{ section.settings.scent_url | default: '/collections/fragrance' }}" class="sc"><span class="eyebrow">The Scent Studio</span><b>Fine fragrance</b></a></div>
    {%- for link in drawer.links -%}
      {%- if link.links.size > 0 -%}
        <details class="dn-g"><summary>{{ link.title | escape }}</summary><div class="dn-in"><a href="{{ link.url }}">Shop all {{ link.title | downcase | escape }}</a>
          {%- for col in link.links -%}<span class="eyebrow">{{ col.title | escape }}</span>{%- for l in col.links -%}<a href="{{ l.url }}">{{ l.title | escape }}</a>{%- endfor -%}{%- endfor -%}</div></details>
      {%- elsif link.title contains 'Advent' -%}
        <a href="{{ link.url }}" class="dn-advent">{{ link.title | escape }} <small>Christmas 2026</small></a>
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
    <div class="dn-foot"><a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}">Wishlist</a><a href="/pages/shipping">Delivery &amp; returns</a><a href="/pages/contact">Contact us</a><p>Official UK partner of Deyga &amp; Vilvah · Free UK delivery over £{{ section.settings.delivery_min }}</p></div>
  </nav></template>

{%- comment -%} Config for sw-proto.js: offers, payment names, bag 'Little extras' (available products under £12) {%- endcomment -%}
{%- liquid
  assign extras_c = collections[section.settings.extras_collection]
-%}
{%- capture pays -%}{% render 'sw-p-pays' %}{%- endcapture -%}{%- assign pays = pays | split: '|' -%}
<script type="application/json" id="sw-config">{
  "offers": {"delivery": {{ section.settings.delivery_min }}, "bonus": {"min": {{ section.settings.bonus_min }}, "off": {{ section.settings.bonus_off }}}},
  "count": {{ collections.all.products_count | json }},
  "returnsUrl": {{ shop.refund_policy.url | default: '/pages/shipping' | json }},
  "pays": {{ pays | json }},
  "extras": [{%- assign k = 0 -%}{%- for p in extras_c.products limit: 60 -%}{%- if p.available and p.selected_or_first_available_variant.price < 1200 and k < 12 -%}{%- assign k = k | plus: 1 -%}{%- capture pn -%}{% render 'sw-p-name', product: p %}{%- endcapture -%}{% unless k == 1 %},{% endunless %}{%- capture vid -%}{% render 'sw-p-variant', product: p %}{%- endcapture -%}{"id": {{ vid }}, "title": {{ pn | json }}, "price": {{ p.selected_or_first_available_variant.price }}, "img": {{ p.featured_media.preview_image | image_url: width: 200 | json }}}{%- endif -%}{%- endfor -%}]
}</script>

<template id="swPayIcons">{%- render 'sw-p-pay-icons' -%}</template>
<div class="swp swp-fixed">
  <div id="layer"></div>
  <button class="chatbtn" id="chatBtn" aria-expanded="false" aria-controls="chatPanel"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"></path></svg><span>Help</span></button>
  <div class="chatpanel" id="chatPanel" role="dialog" aria-label="Help and chat" hidden>
    <div class="cp-head"><b>Hi, how can we help?</b><button data-chatclose aria-label="Close help">×</button></div>
    <p>We usually reply within a few hours, Monday to Friday.</p>
    {%- if settings.social_instagram_link != blank -%}<a class="cp-opt" href="https://ig.me/m/swansura_thebodystudio" target="_blank" rel="noopener"><b>Message us on Instagram</b><small>@swansura_thebodystudio</small></a>{%- endif -%}
    {%- if section.settings.whatsapp != blank -%}{%- assign wa = section.settings.whatsapp | remove: ' ' | remove: '+' -%}<a class="cp-opt" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener"><b>Message us on WhatsApp</b><small>{{ section.settings.whatsapp }} · messages only</small></a>{%- endif -%}
    {%- if section.settings.email != blank -%}<a class="cp-opt" href="mailto:{{ section.settings.email }}"><b>Email us</b><small>{{ section.settings.email }}</small></a>{%- endif -%}
    <div class="cp-q"><span class="eyebrow">Quick answers</span><a href="/pages/shipping" data-chatclose>Delivery and returns</a><a href="/pages/offers" data-chatclose>Offers and discount codes</a><a href="/pages/faq" data-chatclose>Is everything authentic?</a><a href="/collections/perfume-gift-sets" data-chatclose>Help me choose a gift</a></div>
  </div>
</div>

{% schema %}
{
  "name": "Swansura header",
  "class": "sw-header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "link_list", "id": "drawer_menu", "label": "Phone menu (drawer)" },
    { "type": "text", "id": "feat_skin_item", "label": "Menu item with the skincare feature", "default": "Skincare" },
    { "type": "product", "id": "feat_skin", "label": "Skincare feature product" },
    { "type": "text", "id": "feat_scent_item", "label": "Menu item with the fragrance feature", "default": "Fragrance" },
    { "type": "product", "id": "feat_scent", "label": "Fragrance feature product" },
    { "type": "url", "id": "brands_url", "label": "Brands A–Z link" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page" },
    { "type": "text", "id": "whatsapp", "label": "Help panel: WhatsApp number (messages only)", "default": "+44 7438 847453" },
    { "type": "text", "id": "email", "label": "Help panel: email", "default": "info@swansura.com" },
    { "type": "url", "id": "skin_url", "label": "Drawer: Skin Studio link" },
    { "type": "url", "id": "scent_url", "label": "Drawer: Scent Studio link" },
    { "type": "collection", "id": "extras_collection", "label": "Bag 'Little extras' from" },
    { "type": "number", "id": "delivery_min", "label": "Free UK delivery from (£)", "default": 40 },
    { "type": "number", "id": "bonus_min", "label": "£ off from (£)", "default": 70 },
    { "type": "number", "id": "bonus_off", "label": "£ off", "default": 5 }
  ]
}
{% endschema %}
