{%- comment -%} Journal list, prototype markup (journalPage()): breadcrumbs, page header with share, story cards (div.journal > a.post). {%- endcomment -%}
<div class="swp app"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:var(--ink)">{{ section.settings.crumb | default: blog.title | escape }}</span></nav>
  <div class="pagehead"><div><div class="eyebrow">{{ blog.title | escape }}</div><h1 data-label="{{ blog.title | escape }}" style="font-size:clamp(34px,4.4vw,60px);margin-top:10px">{{ section.settings.heading | default: blog.title | escape }}</h1><div class="share dark ph"><button class="sharebtn" data-share="{{ blog.url }}" data-share-title="{{ blog.title | escape }} | Swansura" data-share-text="{{ section.settings.lede | strip_html | escape }}" aria-expanded="false" aria-haspopup="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg><span>Share</span></button></div></div>{%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede }}</p>{%- endif -%}</div>
  <section>{%- paginate blog.articles by 12 -%}<div class="journal">
    {%- for a in blog.articles -%}{%- assign words = a.content | strip_html | split: ' ' | size -%}{%- assign mins = a.metafields.custom.read_minutes.value | default: words -%}{%- if mins > 60 -%}{%- assign mins = mins | divided_by: 140 | at_least: 1 -%}{%- endif -%}
      <a class="post" href="{{ a.url }}">{%- if a.image -%}{{ a.image | image_url: width: 800 | image_tag: class: 'pic', widths: '400,600,800', sizes: '(min-width: 1000px) 400px, 90vw', loading: 'lazy', alt: a.image.alt | default: a.title }}{%- else -%}<div class="pic"></div>{%- endif -%}<span class="eyebrow">{{ a.tags.first | default: blog.title | escape }} · {{ mins }} min read</span><h2 class="ph">{{ a.title | escape }}</h2><p style="color:var(--ink-2)">{{ a.excerpt_or_content | strip_html | truncatewords: 30 }}</p><span class="p-link" style="align-self:start">Read the article</span></a>
    {%- endfor -%}
  </div>{%- if paginate.pages > 1 -%}<div class="more">{{ paginate | default_pagination }}</div>{%- endif -%}{%- endpaginate -%}</section>
</div></div>

{% schema %}
{
  "name": "Swansura journal",
  "settings": [
    { "type": "text", "id": "crumb", "label": "Breadcrumb", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories from the Studio" },
    { "type": "richtext", "id": "lede", "label": "Intro", "default": "<p>Guides to ingredients, rituals and fragrance, each linking to the brands and products it mentions.</p>" }
  ]
}
{% endschema %}
