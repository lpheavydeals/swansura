{%- comment -%} Product grid with tabs (e.g. Iconic bestsellers: Skincare & body / Fragrance). Uses Dawn's product card. {%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<section class="sw-sec sw-tabs" data-sw-tabs>
  <div class="page-width">
    <div class="sw-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}<a class="sw-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="sw-tabs__bar" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" id="sw-tab-{{ block.id }}" aria-controls="sw-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div class="sw-tabs__panel" role="tabpanel" id="sw-panel-{{ block.id }}" aria-labelledby="sw-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
        <ul class="sw-grid grid product-grid" role="list">
          {%- assign list = block.settings.products -%}
          {%- if list == blank -%}{%- assign list = block.settings.collection.products -%}{%- endif -%}
          {%- for product in list limit: block.settings.limit -%}
            <li class="grid__item">
              {% render 'card-product', card_product: product, media_aspect_ratio: 'portrait', image_shape: 'default', show_secondary_image: true, show_vendor: section.settings.show_vendor, show_rating: false, lazy_load: true, section_id: section.id, quick_add: 'standard' %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Swansura product tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Iconic bestsellers" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show brand on cards (turn on once vendors are cleaned up)", "default": false }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Skincare & body" },
      { "type": "product_list", "id": "products", "label": "Products (hand-picked)", "limit": 12 },
      { "type": "collection", "id": "collection", "label": "or a collection" },
      { "type": "range", "id": "limit", "label": "Products shown", "min": 4, "max": 12, "step": 4, "default": 8 }
    ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Swansura product tabs", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
