{%- comment -%}
  Journal article, prototype markup (articlePage()): breadcrumbs, header (tag, H1, summary, author · date · read time,
  share), hero image, body, 'Shop the story' (custom.products), 'Keep reading' (other articles), BlogPosting JSON-LD.
{%- endcomment -%}
{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign mins = article.metafields.custom.read_minutes.value | default: words
  if mins > 60
    assign mins = mins | divided_by: 140 | at_least: 1
  endif
  assign shop_list = article.metafields.custom.products.value
-%}
<div class="swp app"><div class="wrap p-article"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ blog.url }}">{{ section.settings.crumb | default: blog.title | escape }}</a><span>/</span><span style="color:var(--ink)">{{ article.title | escape }}</span></nav>
  <header class="ahead"><div class="eyebrow">{{ article.tags.first | default: blog.title | escape }}</div><h1>{{ article.title | escape }}</h1>{%- if article.excerpt != blank -%}<p class="lede">{{ article.excerpt | strip_html }}</p>{%- endif -%}
    <div class="ameta"><span>{{ section.settings.author }}</span><span>{{ article.published_at | date: '%-d %B %Y' }}</span><span>{{ mins }} min read</span><div class="share ph"><button class="sharebtn" data-share="{{ article.url }}" data-share-title="{{ article.title | escape }} | Swansura" data-share-text="{{ article.excerpt | strip_html | escape }}" data-share-img="{{ article.image | image_url: width: 1000 }}" aria-expanded="false" aria-haspopup="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg><span>Share</span></button></div></div></header>
  {%- comment -%} Shop button under the header (user, 28 Nov 2026: guides got search visits but no add-to-bag): thumbnails + count + button that scrolls to 'Shop the story' {%- endcomment -%}
  {%- if shop_list.size > 0 -%}
    {%- liquid
      assign tag = article.tags.first | default: ''
      assign noun = 'products'
      if tag == 'Scent Studio'
        assign noun = 'perfumes'
      elsif tag == 'Gift guide'
        assign noun = 'gifts'
      endif
      assign n = 0
      assign brands = ''
      for p in shop_list limit: 8
        unless p.available
          continue
        endunless
        assign n = n | plus: 1
        assign v = p.vendor
        if v == 'Swansura - The Body Studio'
          assign v = 'Swansura Selection'
        endif
        unless brands contains v
          assign brands = brands | append: v | append: '|'
        endunless
      endfor
      assign blist = brands | split: '|'
    -%}
    {%- if n > 0 -%}
    <a class="gshop" href="#shop-story" data-gshop><span class="gshop-pics" aria-hidden="true">{%- assign k = 0 -%}{%- for p in shop_list limit: 8 -%}{%- if p.available and p.featured_media and k < 4 -%}{%- assign k = k | plus: 1 -%}<span class="gshop-pic">{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'eager', width: 48, height: 48, alt: '' }}</span>{%- endif -%}{%- endfor -%}</span><span class="gshop-txt"><strong>Shop the {% if n == 1 %}{{ noun | remove_last: 's' }}{% else %}{{ n }} {{ noun }}{% endif %} in this guide</strong><span>{%- for b in blist limit: 3 -%}{{ b | escape }}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}{%- if blist.size > 3 %} and more{% endif -%}</span></span><span class="gshop-btn">Shop now <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg></span></a>
    {%- endif -%}
    <style>
      .swp .gshop{display:flex;align-items:center;gap:16px;margin:24px auto 28px;max-width:900px;padding:12px 14px 12px 16px;border:1px solid var(--line,#E3DACD);border-radius:12px;background:#F7FAF8;color:var(--ink,#1F1A17);text-decoration:none;transition:border-color .2s,box-shadow .2s}
      .swp .gshop:hover{border-color:#1B4D3E;box-shadow:0 4px 18px rgba(27,77,62,.10)}
      .swp .gshop-pics{display:flex;flex:none}
      .swp .gshop-pic{width:48px;height:48px;border-radius:50%;background:#EEF3F0;border:2px solid #fff;overflow:hidden;display:block;margin-left:-14px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
      .swp .gshop-pic:first-child{margin-left:0}
      .swp .gshop-pic img{width:100%;height:100%;object-fit:contain;padding:4px;mix-blend-mode:multiply}
      .swp .gshop-txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;line-height:1.3}
      .swp .gshop-txt strong{font-size:15px;font-weight:700}
      .swp .gshop-txt span{font-size:13px;color:var(--ink-2,#5C4A39);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .swp .gshop-btn{flex:none;display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 18px;border-radius:6px;background:#1B4D3E;color:#fff;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
      .swp #shop-story{scroll-margin-top:110px}
      @media (max-width:600px){
        .swp .gshop{flex-wrap:wrap;gap:10px 12px;padding:12px;margin:18px 0 22px}
        .swp .gshop-pic{width:40px;height:40px;margin-left:-12px}
        .swp .gshop-txt strong{font-size:14px}
        .swp .gshop-btn{width:100%;justify-content:center;height:42px}
      }
    </style>
    <script>document.addEventListener('click',function(e){var a=e.target.closest('[data-gshop]');if(!a)return;var t=document.getElementById('shop-story');if(!t)return;e.preventDefault();t.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});});</script>
  {%- endif -%}
  {%- if article.image -%}<div class="ahero">{%- assign swalt = article.image.alt | default: article.title -%}{{ article.image | image_url: width: 1600 | image_tag: class: 'pic', widths: '800,1200,1600', sizes: '(min-width: 1000px) 900px, 92vw', fetchpriority: 'high', alt: swalt }}</div>{%- endif -%}
  {%- comment -%} 'Shop the story': in-stock cards first, sold out after (user, 28 Nov 2026). Cards sit after the opening section, before the 2nd H2 (user, 14 Nov 2026: in the middle, not at the end); articles with fewer than 2 H2s keep them at the end {%- endcomment -%}
  {%- liquid
    assign parts = article.content | split: '<h2'
    assign mid = false
    if shop_list.size > 0 and parts.size > 2
      assign mid = true
    endif
  -%}
  {%- capture story -%}{%- if shop_list.size > 0 -%}<section class="astory" id="shop-story"{% unless mid %} style="padding-top:8px;border:0"{% endunless %}><div class="sec-head"><div><h2>Shop the story</h2></div></div><div class="grid-p">{%- for p in shop_list limit: 8 -%}{%- if p.available -%}{% render 'sw-p-card', product: p %}{%- endif -%}{%- endfor -%}{%- for p in shop_list limit: 8 -%}{%- unless p.available -%}{% render 'sw-p-card', product: p %}{%- endunless -%}{%- endfor -%}</div></section>{%- endif -%}{%- endcapture -%}
  {%- if mid -%}
    <article class="abody a1">{%- for part in parts limit: 2 -%}{%- unless forloop.first -%}<h2{%- endunless -%}{{ part }}{%- endfor -%}</article>
    {{ story }}
    <div class="abody a2">{%- for part in parts offset: 2 -%}<h2{{ part }}{%- endfor -%}</div>
  {%- else -%}
    <article class="abody">{{ article.content }}</article>
    {{ story }}
  {%- endif -%}
  {%- capture more -%}{%- assign k = 0 -%}{%- for a in blog.articles -%}{%- if a.id != article.id and k < 3 -%}{%- assign k = k | plus: 1 -%}<a class="post" href="{{ a.url }}">{%- if a.image -%}{%- assign swalt = a.image.alt | default: a.title -%}{{ a.image | image_url: width: 800 | image_tag: class: 'pic', widths: '400,600,800', sizes: '(min-width: 1000px) 400px, 90vw', loading: 'lazy', alt: swalt }}{%- else -%}<div class="pic"></div>{%- endif -%}<span class="eyebrow">{{ a.tags.first | default: blog.title | escape }}</span><h3>{{ a.title | escape }}</h3><p style="color:var(--ink-2)">{{ a.excerpt_or_content | strip_html | truncatewords: 30 }}</p></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {%- if more != blank -%}<section style="padding-top:0"><div class="sec-head"><div><h2>Keep reading</h2></div><a class="p-link" href="{{ blog.url }}">All stories</a></div><div class="journal">{{ more }}</div></section>{%- endif -%}
</div></div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ article.title | json }},"description":{{ article.excerpt | strip_html | json }},"datePublished":{{ article.published_at | date: '%Y-%m-%d' | json }},"dateModified":{{ article.updated_at | date: '%Y-%m-%d' | json }},"author":{"@type":"Organization","name":{{ section.settings.author | json }}},"publisher":{"@type":"Organization","name":{{ shop.name | json }}},{% if article.image %}"image":{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},{% endif %}"mainEntityOfPage":{{ shop.url | append: article.url | json }}}</script>

{% schema %}
{
  "name": "Swansura article",
  "settings": [
    { "type": "text", "id": "crumb", "label": "Breadcrumb", "default": "Journal" },
    { "type": "text", "id": "author", "label": "Author line", "default": "Swansura Studio" }
  ]
}
{% endschema %}
